{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src",
    "evidence/**/*.ts",
    "tests/**/*.spec.ts",
    "vite.config.ts",
    "vite.evidence.config.ts"
  ]
}
